rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: only the signed-in owner.
    function isOwner(uid) {
      return request.auth != null && request.auth.uid == uid;
    }

    // Keep this in sync with TermsContent.currentVersion in the app.
    function currentTermsVersion() {
      return "2026-04-10";
    }

    // Keep this in sync with TermsContent.privacyPolicyVersion in the app.
    function currentPrivacyVersion() {
      return "2026-04-10";
    }

    // True when the user doc has accepted current terms and privacy versions.
    function hasAcceptedCurrentLegalVersions(uid) {
      return exists(/databases/$(database)/documents/users/$(uid))
        && get(/databases/$(database)/documents/users/$(uid)).data.termsVersion == currentTermsVersion()
        && get(/databases/$(database)/documents/users/$(uid)).data.privacyVersion == currentPrivacyVersion()
        && get(/databases/$(database)/documents/users/$(uid)).data.acceptedAt is timestamp;
    }

    function legalAcceptanceFields() {
      return ["termsVersion", "privacyVersion", "acceptedAt", "appVersion"];
    }

    function requiredLegalAcceptanceFields() {
      return ["termsVersion", "privacyVersion", "acceptedAt"];
    }

    function hasValidLegalAcceptanceValues(data) {
      return data.keys().hasAll(requiredLegalAcceptanceFields())
        && data.termsVersion == currentTermsVersion()
        && data.privacyVersion == currentPrivacyVersion()
        && data.acceptedAt == request.time
        && (!("appVersion" in data) || data.appVersion is string);
    }

    function createsOnlyLegalAcceptanceFields() {
      return request.resource.data.keys().hasOnly(legalAcceptanceFields())
        && hasValidLegalAcceptanceValues(request.resource.data);
    }

    function updatesOnlyLegalAcceptanceFields() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(legalAcceptanceFields())
        && hasValidLegalAcceptanceValues(request.resource.data);
    }

    // Allow a user to read/delete their own user doc.
    // Client writes are limited to legal acceptance metadata.
    match /users/{uid} {
      allow read, delete: if isOwner(uid);
      allow create: if isOwner(uid) && createsOnlyLegalAcceptanceFields();
      allow update: if isOwner(uid) && updatesOnlyLegalAcceptanceFields();
    }

    // Allow reads for the owner.
    // Allow writes only after accepting current legal versions.
    match /users/{uid}/{collection}/{document=**} {
      allow read: if isOwner(uid);
      allow delete: if isOwner(uid);
      allow create, update: if isOwner(uid) && hasAcceptedCurrentLegalVersions(uid);
    }

    // Everything else denied by default.
    match /{path=**} {
      allow read, write: if false;
    }
  }
}
